parameters:
	ignoreErrors:
		-
			message: '#^Binary operation "\+" between mixed and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Binary operation "\." between ''\<a href\="game\.php…'' and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 1
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Binary operation "\." between non\-falsy\-string and mixed results in an error\.$#'
			identifier: binaryOp.invalid
			count: 4
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Cannot access offset ''crystal'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Cannot access offset ''deuterium'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Cannot access offset ''energy'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Cannot access offset ''metal'' on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Cannot access offset int on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Cannot access offset int\<200, 499\> on mixed\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Cannot cast mixed to int\.$#'
			identifier: cast.int
			count: 43
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Instanceof between App\\Core\\GameObjects\\Ship and App\\Core\\GameObjects\\Ship will always evaluate to true\.$#'
			identifier: instanceof.alwaysTrue
			count: 1
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Method App\\Services\\Game\\TechnologyInfoService\:\:getNextJumpWaitTime\(\) should return array\{string\: string, value\: int\} but returns array\{string\: non\-falsy\-string, value\: float\|int\}\.$#'
			identifier: return.type
			count: 1
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Offset int\<min, 11\>\|int\<13, max\> might not exist on array\{1\: float\|int, 2\: float\|int, 3\: float\|int, 4\: float\|int\}\.$#'
			identifier: offsetAccess.notFound
			count: 4
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Result of \|\| is always true\.$#'
			identifier: booleanOr.alwaysTrue
			count: 1
			path: app/Services/Game/TechnologyInfoService.php

		-
			message: '#^Trying to invoke mixed but it''s not a callable\.$#'
			identifier: callable.nonCallable
			count: 4
			path: app/Services/Game/TechnologyInfoService.php
