APP_NAME=xgproyect
APP_SERVICE=xgproyect
APP_VERSION=4.0.0
# ask updates.xgproyect.org for new releases in the admin panel
XGP_UPDATE_CHECK=false
APP_ENV=production
APP_KEY=base64:S5umA/0fcvXfOda1+4J+Rh1gLi33kRKQm+FVWMv6OII=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=xgproyect
DB_USERNAME=xgp
DB_PASSWORD=xgp
DB_PREFIX=xgp_

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
# behind HTTPS (always, with money in the game): cookies only over HTTPS
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SAIL_XDEBUG_MODE=develop,debug,coverage

# A new universe every month (see config/instances.php); needs the cron entry
# * * * * * php artisan schedule:run
XGP_MONTHLY_ENABLED=false
XGP_MONTHLY_SLUG=":year-:month"
XGP_MONTHLY_NAME="Universe :year-:month"
XGP_MONTHLY_MODE=play2win
XGP_MONTHLY_PAYMENTS=stripe
XGP_MONTHLY_OPTIONS=
XGP_MONTHLY_KEEP_OPEN=0
XGP_MONTHLY_BOTS=0
XGP_MONTHLY_DURATION="1 month"
XGP_MONTHLY_ADMIN_NAME=
XGP_MONTHLY_ADMIN_EMAIL=
XGP_MONTHLY_ADMIN_PASSWORD=

# Dark matter shop (only in Pay2Win universes, see config/premium.php).
# Without both keys there is no card payment. Stripe dashboard → Developers:
# STRIPE_SECRET: the secret API key, sk_test_… in test mode, sk_live_… live.
# STRIPE_WEBHOOK_SECRET: the signing secret (whsec_…) of the webhook endpoint
#   https://<your domain>/stripe/webhook with the events
#   checkout.session.completed, checkout.session.expired,
#   checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
#   and charge.refunded.
# STRIPE_CURRENCY: ISO code of the package prices (default eur).
#STRIPE_SECRET=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_CURRENCY=eur

# Dark matter paid in WAX (only where a universe allows it: --payments=wax).
# XGP_WAX_ACCOUNT: the shop's WAX account; the scheduler then runs
# xgp:wax:check every minute (cron: * * * * * php artisan schedule:run).
# The price is converted from the package price at the current rate
# (CoinGecko), plus XGP_WAX_MARKUP percent.
#XGP_WAX_ACCOUNT=
#XGP_WAX_API=https://wax.eosusa.io
#XGP_WAX_MARKUP=0
# A second Hyperion server of another operator confirms each transfer
# before it counts (one server alone could make up payments); empty: off.
#XGP_WAX_VERIFY_API=https://api.waxsweden.org
# A WAX rate more than this many percent off the last one is refused.
#XGP_WAX_MAX_RATE_JUMP=50

# The game's own token on the WAX chain (payment method "token", and season
# prizes via xgp:season:payout). Paid to XGP_WAX_ACCOUNT at a fixed rate:
# XGP_TOKEN_DARK_MATTER dark matter for one token. Only this contract and
# symbol count. The market price in WAX is shown for comparison (Alcor).
#XGP_TOKEN_CONTRACT=
#XGP_TOKEN_SYMBOL=
#XGP_TOKEN_DECIMALS=4
#XGP_TOKEN_DARK_MATTER=100
#XGP_TOKEN_MARKET_URL=https://wax.alcor.exchange/api/v2/tokens/:id

# The admin area asks for two-factor sign-in (authenticator app); an admin
# without it is sent to set it up first. Only switch off for local work.
XGP_ADMIN_TWO_FACTOR=true

# The operators' area /operator: managing the universes in the browser,
# always with two-factor sign-in (accounts: php artisan xgp:operator:create).
# XGP_OPERATOR_IPS: only from these addresses or networks (comma-separated);
# XGP_OPERATOR_WEB=false switches the area off.
#XGP_OPERATOR_IPS=203.0.113.7,10.0.0.0/8
#XGP_OPERATOR_WEB=true

# Season prizes (dark matter) for the best ten of each ranking, see
# config/seasons.php; a universe keeps the plan it was created with.
#XGP_SEASON_REWARDS="total=100000,buildings=20000,technology=20000,ships=20000,defenses=20000,military=20000"
#XGP_SEASON_SHARES="30,20,15,10,7,6,4,3,3,2"

# Cheat detection (xgp:cheat:scan, hourly), see config/cheats.php
#XGP_CHEATS_PUSHING_RESOURCES=100000
#XGP_CHEATS_REQUESTS_PER_HOUR=1200
