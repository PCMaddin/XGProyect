APP_NAME=xgproyect
APP_SERVICE=xgproyect
# the version of the code is config/version.php (never set here: every
# version on the server reads this file)
# ask updates.xgproyect.org for new releases in the admin panel
XGP_UPDATE_CHECK=false
APP_ENV=production
APP_KEY=base64:S5umA/0fcvXfOda1+4J+Rh1gLi33kRKQm+FVWMv6OII=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=xgproyect
DB_USERNAME=xgp
DB_PASSWORD=xgp
DB_PREFIX=xgp_

BROADCAST_DRIVER=log
# one small server: files and the database are enough; with many players or
# several app servers: CACHE_DRIVER=redis and SESSION_DRIVER=redis (each
# universe keeps its own keys, see docs/universes.md)
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120
# behind HTTPS (always, with money in the game): cookies only over HTTPS
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# the cache in database 1, the sessions in database 2; for the sessions
# better a Redis of their own that never evicts keys (logins would vanish)
# REDIS_SESSION_HOST=127.0.0.1
# REDIS_SESSION_PORT=6380
# REDIS_SESSION_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

SAIL_XDEBUG_MODE=develop,debug,coverage

# A new universe every month (see config/instances.php); needs the cron entry
# * * * * * php artisan schedule:run
XGP_MONTHLY_ENABLED=false
XGP_MONTHLY_SLUG=":year-:month"
XGP_MONTHLY_NAME="Universe :year-:month"
XGP_MONTHLY_MODE=play2win
XGP_MONTHLY_PAYMENTS=stripe
XGP_MONTHLY_OPTIONS=
XGP_MONTHLY_KEEP_OPEN=0
XGP_MONTHLY_BOTS=0
XGP_MONTHLY_DURATION="1 month"
XGP_MONTHLY_ADMIN_NAME=
XGP_MONTHLY_ADMIN_EMAIL=
XGP_MONTHLY_ADMIN_PASSWORD=

# The errors of every universe are collected for /operator → Errors; a mail
# goes to XGP_ERRORS_MAIL (comma separated) once a kind of error happened
# XGP_ERRORS_THRESHOLD times since the last mail (at most hourly per kind).
XGP_ERRORS_MAIL=
XGP_ERRORS_THRESHOLD=5

# Backups of every database to another server with restic (xgp:backup:run,
# nightly at XGP_BACKUP_TIME); see config/offsite.php for the repositories.
#XGP_BACKUP_REPOSITORY=s3:https://s3.eu-central-1.amazonaws.com/bucket/xgproyect
#XGP_BACKUP_PASSWORD=
#XGP_BACKUP_TIME=03:17
# closed universes archived to the backup server after so many days (0: never)
#XGP_ARCHIVE_AFTER_DAYS=0
# Universes play on the version of the code they were created with; every
# version in use lies in a directory under this path (php artisan
# xgp:versions:sync after an update, xgp:instance:upgrade moves a universe).
# Empty: storage/versions. The Docker stack uses the volume /srv/versions.
XGP_VERSIONS_PATH=
# repositories /operator may fetch a version from besides the origin of this
# checkout, comma separated (a fetch runs the fetched code; the command line
# takes any repository)
XGP_VERSIONS_REPOSITORIES=

# Dark matter shop (only in Pay2Win universes, see config/premium.php).
# Without both keys there is no card payment. Stripe dashboard → Developers:
# STRIPE_SECRET: the secret API key, sk_test_… in test mode, sk_live_… live.
# STRIPE_WEBHOOK_SECRET: the signing secret (whsec_…) of the webhook endpoint
#   https://<your domain>/stripe/webhook with the events
#   checkout.session.completed, checkout.session.expired,
#   checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#   charge.refunded and charge.dispute.created.
# STRIPE_CURRENCY: ISO code of the package prices (default eur).
# STRIPE_AUTOMATIC_TAX=true: Stripe Tax (dashboard → Tax) works the VAT of the
#   buyer's country out of the price (EU: taxed where the buyer lives); the
#   order keeps tax and country for the books. Needs Stripe Tax set up.
#STRIPE_SECRET=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#STRIPE_CURRENCY=eur
#STRIPE_AUTOMATIC_TAX=false

# Test payments only (an alpha): a live Stripe key (sk_live_…) or the WAX
# main network close that way to pay, and the shop says that no real money
# moves. XGP_WAX_NETWORK=testnet uses the WAX test network (and its history
# server testnet.waxsweden.org); the server must be on that chain.
XGP_PAYMENTS_TEST=false
#XGP_WAX_NETWORK=mainnet

# Dark matter paid in WAX (only where a universe allows it: --payments=wax).
# XGP_WAX_ACCOUNT: the shop's WAX account; the scheduler then runs
# xgp:wax:check every minute (cron: * * * * * php artisan schedule:run).
# The price is converted from the package price at the current rate
# (CoinGecko), plus XGP_WAX_MARKUP percent.
#XGP_WAX_ACCOUNT=
#XGP_WAX_API=https://wax.eosusa.io
#XGP_WAX_MARKUP=0
# A second Hyperion server of another operator confirms each transfer
# before it counts (one server alone could make up payments); empty: off.
#XGP_WAX_VERIFY_API=https://api.waxsweden.org
# A WAX rate more than this many percent off the last one is refused.
#XGP_WAX_MAX_RATE_JUMP=50

# The game's own token on the WAX chain (payment method "token", and season
# prizes via xgp:season:payout). Paid to XGP_WAX_ACCOUNT at a fixed rate:
# XGP_TOKEN_DARK_MATTER dark matter for one token. Only this contract and
# symbol count. The market price in WAX is shown for comparison (Alcor).
#XGP_TOKEN_CONTRACT=
#XGP_TOKEN_SYMBOL=
#XGP_TOKEN_DECIMALS=4
#XGP_TOKEN_DARK_MATTER=100
#XGP_TOKEN_MARKET_URL=https://wax.alcor.exchange/api/v2/tokens/:id

# The admin area asks for two-factor sign-in (authenticator app); an admin
# without it is sent to set it up first. Only switch off for local work.
XGP_ADMIN_TWO_FACTOR=true
# behind a reverse proxy that speaks HTTP to the game (not the Docker stack):
# its addresses, so players keep their own (rate limits, sign-in log);
# "203.0.113.7,10.0.0.0/8" or "*"; empty: no X-Forwarded-* header is trusted
XGP_TRUSTED_PROXIES=

# The operators' area /operator: managing the universes in the browser,
# always with two-factor sign-in (accounts: php artisan xgp:operator:create).
# XGP_OPERATOR_IPS: only from these addresses or networks (comma-separated);
# XGP_OPERATOR_WEB=false switches the area off.
#XGP_OPERATOR_IPS=203.0.113.7,10.0.0.0/8
#XGP_OPERATOR_WEB=true

# Season prizes (dark matter) for the best ten of each ranking, see
# config/seasons.php; a universe keeps the plan it was created with.
#XGP_SEASON_REWARDS="total=100000,buildings=20000,technology=20000,ships=20000,defenses=20000,military=20000"
#XGP_SEASON_SHARES="30,20,15,10,7,6,4,3,3,2"

# Cheat detection (xgp:cheat:scan, hourly), see config/cheats.php
#XGP_CHEATS_PUSHING_RESOURCES=100000
#XGP_CHEATS_REQUESTS_PER_HOUR=1200
