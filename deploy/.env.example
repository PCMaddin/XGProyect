# Settings of the server stack (deploy/docker-compose.yml). Copy to
# deploy/.env; deploy.sh fills in the empty keys and passwords once.
# Any other key of the game's ../.env.example (Stripe, WAX, monthly
# universe, operators, mail) can be added here as well.

# --- the server
# the public name; Caddy gets the certificate for it (DNS must point here)
XGP_DOMAIN=game.example.com
# Let's Encrypt writes here before a certificate runs out
ACME_EMAIL=admin@example.com
HTTP_PORT=80
HTTPS_PORT=443
# php-fpm containers and workers in each: about 2 vCPU per 1,000 players
# online; workers ≈ 4 per vCPU, each needs up to 256 MB
APP_REPLICAS=2
PHP_FPM_CHILDREN=16
# MariaDB's cache: about the size of the data (1 million players ≈ 2.5 GB)
DB_BUFFER_POOL=2G
REDIS_CACHE_MEMORY=512mb

# --- the game
APP_NAME=xgproyect
APP_ENV=production
APP_DEBUG=false
APP_URL=https://game.example.com
APP_KEY=
XGP_SECRETWORD=
XGP_UPDATE_CHECK=false
LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=xgp
DB_USERNAME=xgp
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_PREFIX=xgp_

CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=sync
REDIS_CLIENT=phpredis
REDIS_HOST=redis-cache
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_SESSION_HOST=redis-sessions
REDIS_SESSION_DB=0

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=game@example.com
MAIL_FROM_NAME=XGProyect

XGP_ADMIN_TWO_FACTOR=true

# --- payments
# The alpha: test payments only (Stripe sk_test_… key, WAX test network).
# Set to false for real money once the legal texts and a security test are
# done (see docs/universes.md).
XGP_PAYMENTS_TEST=true
XGP_WAX_NETWORK=testnet
#STRIPE_SECRET=sk_test_...
#STRIPE_WEBHOOK_SECRET=whsec_...
#XGP_WAX_ACCOUNT=
